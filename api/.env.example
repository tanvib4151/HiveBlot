# --- New Supabase project (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- OpenAI ---
OPENAI_KEY=

# --- Dedicated read-only Postgres role (see db/schema.sql) ---
# postgresql://hive_readonly:<password>@<host>:5432/postgres
DB_READONLY_URL=

# --- Internal API: shared secret used only by web/'s server-side route ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# --- External API (/v1/search): comma-separated keys, one per agent/integration ---
# Generate each the same way. Revoke one agent by removing its key here,
# without touching INTERNAL_API_KEY or any other agent's key.
AGENT_API_KEYS=

# --- Comma-separated list of exact frontend origins allowed to call the internal API ---
ALLOWED_ORIGINS=http://localhost:3000

SEARCH_RATE_LIMIT=20/minute
AGENT_RATE_LIMIT=10/minute
